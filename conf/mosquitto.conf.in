per_listener_settings false

listener @MOSQUITTO_PORT@

plugin @MOSQUITTO_DYNSEC_LIB_PATH@
plugin_opt_config_file @MOSQUITTO_DYNSEC_CONF_PATH@

pid_file @MOSQUITTO_PID_PATH@

allow_anonymous false
require_certificate false
tls_version tlsv1.2
certfile @MOSQUITTO_CERT_PATH@
keyfile @MOSQUITTO_PKEY_PATH@

max_keepalive 900
message_size_limit 10000