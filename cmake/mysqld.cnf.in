[mysqld]
user		= mysql
pid-file	= @mysql_pid_path@
port		= @mysql_port@
datadir	    = @mysql_datadir@
log_error   = @GECKO_ROOT@/run/.mysql/error.log 

bind-address		    = 127.0.0.1
mysqlx-bind-address	    = 127.0.0.1
key_buffer_size		    = 16M
myisam-recover-options  = BACKUP

max_binlog_size = 100M
